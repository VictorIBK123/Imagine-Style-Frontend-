{
  "expo": {
    "name": "ImagineStyle",
    "slug": "ImagineStyle",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "imaginestyle",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.victoribk.imaginestyle",
      "supportsTablet": true
    },
    "android": {
      "package": "com.victoribk.imaginestyle",
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0C",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0A0C",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow ImagineStyle to access your photo library to select portraits for AI generation.",
          "cameraPermission": "Allow ImagineStyle to access your camera to take selfies for AI generation."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow ImagineStyle to access your photo library to save generated portraits.",
          "savePhotosPermission": "Allow ImagineStyle to save generated portraits to your photo library."
        }
      ],
      "expo-secure-store",
      "expo-apple-authentication",
      "expo-sharing",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "6d02e6df-c6d7-4c10-9ede-e90809c87a1b"
      }
    },
    "owner": "victoribk"
  }
}
